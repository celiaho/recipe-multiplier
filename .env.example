# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real secrets.
# All variables listed here must also be added to Vercel:
#   vercel.com → project → Settings → Environment Variables

# Supabase — get these from supabase.com → project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Resend — get this from resend.com → API Keys
# Used by: src/app/api/contact/route.ts (contact form email)
RESEND_API_KEY=re_your_resend_api_key
